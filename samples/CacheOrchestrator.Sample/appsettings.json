{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "CacheOrchestrator": "Information"
    }
  },
  "AllowedHosts": "*",
  "Sample": {
    "SqlitePath": "Data/playground.db"
  },
  "Cache": {
    "Namespace": "sample",
    "InstanceId": "local-playground",
    "Metrics": {
      "IncludeEndpointLabel": true
    },
    "Admin": {
      "Enabled": true,
      "ApiKey": "dev-admin-key",
      "TrackLatency": true,
      "TrackResultSize": true
    },
    "OutputCache": {
      "Provider": "InMemory"
    },
    "DataCacheInstances": {
      "default": {
        "Provider": "InMemory"
      }
    },
    "Redis": {
      "Configuration": "localhost:6379"
    },
    "DomainDefaults": {
      "DataCache": {
        "Enabled": true,
        "TtlSeconds": 60
      },
      "OutputCache": {
        "Enabled": true,
        "TtlSeconds": 20
      },
      "ClientCache": {
        "Cacheability": "Public",
        "TtlSeconds": 20,
        "TtlMinSeconds": 10
      },
      "FusionCache": {
        "HardTtlSeconds": 120,
        "FailSafeSeconds": 600
      }
    },
    "Domains": {
      "promotions": {
        "Version": "1",
        "OutputCache": {
          "TtlSeconds": 8
        },
        "ClientCache": {
          "Cacheability": "Public",
          "TtlSeconds": 5,
          "TtlMinSeconds": 3
        }
      },
      "catalog": {
        "Version": "1",
        "DataCache": {
          "TtlSeconds": 45
        },
        "OutputCache": {
          "TtlSeconds": 12
        },
        "ClientCache": {
          "Cacheability": "Public",
          "TtlSeconds": 15,
          "TtlMinSeconds": 8
        },
        "FusionCache": {
          "HardTtlSeconds": 90
        }
      },
      "product-search": {
        "Version": "v1",
        "DataCache": {
          "TtlSeconds": 45
        },
        "OutputCache": {
          "TtlSeconds": 20
        },
        "ClientCache": {
          "Cacheability": "Public",
          "TtlSeconds": 10,
          "TtlMinSeconds": 5
        },
        "FusionCache": {
          "HardTtlSeconds": 90
        }
      },
      "product-crud": {
        "Version": "1",
        "DataCache": {
          "TtlSeconds": 90
        },
        "OutputCache": {
          "TtlSeconds": 45,
          "ETagMode": "Resource"
        },
        "ClientCache": {
          "Cacheability": "Public",
          "TtlSeconds": 20,
          "TtlMinSeconds": 10
        },
        "FusionCache": {
          "HardTtlSeconds": 180
        }
      },
      "vary-demo": {
        "Version": "v1",
        "VaryByAccept": true,
        "AcceptNormalizationList": [
          "application/json",
          "application/xml"
        ],
        "VaryByQueryKeys": [
          "lang"
        ],
        "AuthBypassMode": "Never",
        "VaryOutputCacheByUser": false,
        "DataCache": {
          "TtlSeconds": 60
        },
        "OutputCache": {
          "TtlSeconds": 30
        },
        "ClientCache": {
          "Cacheability": "Public",
          "TtlSeconds": 20,
          "TtlMinSeconds": 10
        },
        "FusionCache": {
          "HardTtlSeconds": 120
        }
      }
    }
  }
}
