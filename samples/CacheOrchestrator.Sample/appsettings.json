{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "CacheOrchestrator": "Information"
    }
  },
  "AllowedHosts": "*",
  "Cache": {
    "Namespace": "sample",
    "InstanceId": "local-playground",
    "Metrics": {
      "IncludeEndpointLabel": true
    },
    "Admin": {
      "Enabled": true,
      "ApiKey": "dev-admin-key"
    },
    "OutputCache": {
      "Provider": "InMemory"
    },
    "FusionCacheInstances": {
      "default": {
        "Provider": "InMemory"
      }
    },
    "Redis": {
      "Configuration": "localhost:6379"
    },
    "DomainDefaults": {
      "OutputCacheEnabled": true,
      "FusionCacheEnabled": true,
      "ClientCacheability": "Public",
      "ClientTtlSeconds": 30,
      "ClientTtlMinSeconds": 30,
      "OutputCacheTtlSeconds": 30,
      "FusionCacheSoftTtlSeconds": 60,
      "FusionCacheHardTtlSeconds": 300,
      "FusionCacheFailSafeSeconds": 3600
    },
    "Domains": {
      "catalog": {
        "Version": "v2",
        "OutputCacheTtlSeconds": 5,
        "FusionCacheSoftTtlSeconds": 20,
        "ClientCacheability": "Public",
        "ClientTtlSeconds": 10,
        "ClientTtlMinSeconds": 60
      },
      "product-detail": {
        "Version": "v1",
        "OutputCacheTtlSeconds": 60,
        "ClientCacheability": "Public",
        "ClientTtlSeconds": 60,
        "ClientTtlMinSeconds": 30
      },
      "search": {
        "Version": "v1",
        "OutputCacheTtlSeconds": 15,
        "ClientCacheability": "Public",
        "ClientTtlSeconds": 15,
        "ClientTtlMinSeconds": 15
      },
      "product-crud": {
        "Version": "1",
        "ETagMode": "Resource",
        "OutputCacheTtlSeconds": 60,
        "FusionCacheSoftTtlSeconds": 120,
        "ClientCacheability": "Public",
        "ClientTtlSeconds": 10,
        "ClientTtlMinSeconds": 10
      }
    }
  },
  "Demo": {
    "Endpoints": [
      {
        "Path": "/api/catalog",
        "Domain": "catalog",
        "DelayMs": 80,
        "Label": "Catalog"
      },
      {
        "Path": "/api/products/{id}",
        "Domain": "product-detail",
        "DelayMs": 60,
        "Label": "Product detail (id=42)"
      },
      {
        "Path": "/api/search",
        "Domain": "search",
        "DelayMs": 40,
        "Label": "Search"
      }
    ]
  }
}