{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "CacheOrchestrator": "Information"
    }
  },
  "AllowedHosts": "*",
  "Cache": {
    "Namespace": "sample",
    "InstanceId": "local-playground",
    "Metrics": {
      "IncludeEndpointLabel": true
    },
    "Admin": {
      "Enabled": true,
      "ApiKey": "dev-admin-key",
      "TrackLatency": true,
      "TrackResultSize": true
    },
    "OutputCache": {
      "Provider": "InMemory"
    },
    "DataCacheInstances": {
      "default": {
        "Provider": "InMemory"
      }
    },
    "Redis": {
      "Configuration": "localhost:6379"
    },
    "DomainDefaults": {
      "DataCache": {
        "Enabled": true,
        "TtlSeconds": 60,
        "VaryOnPublicAddress": false
      },
      "OutputCache": {
        "Enabled": true,
        "TtlSeconds": 20,
        "VaryByHost": false
      },
      "ClientCache": {
        "Cacheability": "Public",
        "TtlSeconds": 20,
        "TtlMinSeconds": 10
      },
      "FusionCache": {
        "HardTtlSeconds": 120,
        "FailSafeSeconds": 600
      }
    },
    "Domains": {
      "catalog": {
        "Version": "v9",
        "DataCache": {
          "TtlSeconds": 45
        },
        "OutputCache": {
          "TtlSeconds": 12
        },
        "ClientCache": {
          "Cacheability": "Public",
          "TtlSeconds": 15,
          "TtlMinSeconds": 8
        },
        "FusionCache": {
          "HardTtlSeconds": 90
        }
      },
      "product-detail": {
        "Version": "v1",
        "DataCache": {
          "TtlSeconds": 90
        },
        "OutputCache": {
          "TtlSeconds": 30
        },
        "ClientCache": {
          "Cacheability": "Public",
          "TtlSeconds": 30,
          "TtlMinSeconds": 15
        },
        "FusionCache": {
          "HardTtlSeconds": 180
        }
      },
      "search": {
        "Version": "v1",
        "DataCache": {
          "TtlSeconds": 20
        },
        "OutputCache": {
          "TtlSeconds": 8
        },
        "ClientCache": {
          "Cacheability": "Public",
          "TtlSeconds": 5,
          "TtlMinSeconds": 5
        },
        "FusionCache": {
          "HardTtlSeconds": 40
        }
      },
      "product-crud": {
        "Version": "1",
        "DataCache": {
          "TtlSeconds": 90
        },
        "OutputCache": {
          "TtlSeconds": 45,
          "ETagMode": "Resource"
        },
        "ClientCache": {
          "Cacheability": "Public",
          "TtlSeconds": 20,
          "TtlMinSeconds": 10
        },
        "FusionCache": {
          "HardTtlSeconds": 180
        }
      },
      "vary-demo": {
        "Version": "v1",
        "VaryByAccept": true,
        "AcceptNormalizationList": [
          "application/json",
          "application/xml"
        ],
        "VaryByQueryKeys": [
          "lang"
        ],
        "AuthBypassMode": "Never",
        "VaryOutputCacheByUser": false,
        "DataCache": {
          "TtlSeconds": 60
        },
        "OutputCache": {
          "TtlSeconds": 30
        },
        "ClientCache": {
          "Cacheability": "Public",
          "TtlSeconds": 20,
          "TtlMinSeconds": 10
        },
        "FusionCache": {
          "HardTtlSeconds": 120
        }
      }
    }
  },
  "Demo": {
    "Endpoints": [
      {
        "Path": "/api/catalog",
        "Domain": "catalog",
        "DelayMs": 80,
        "Label": "Catalog"
      },
      {
        "Path": "/api/products/{id}",
        "Domain": "product-detail",
        "DelayMs": 60,
        "Label": "Product detail (id=42)"
      },
      {
        "Path": "/api/search",
        "Domain": "search",
        "DelayMs": 40,
        "Label": "Search"
      }
    ]
  }
}
