{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "CacheOrchestrator": "Information"
    }
  },
  "AllowedHosts": "*",
  "Cache": {
    "Namespace": "sample",
    "InstanceId": "local-playground",
    "Metrics": {
      "IncludeEndpointLabel": true
    },
    "Admin": {
      "Enabled": true,
      "ApiKey": "dev-admin-key",
      "TrackLatency": true,
      "TrackResultSize": true
    },
    "OutputCache": {
      "Provider": "InMemory"
    },
    "FusionCacheInstances": {
      "default": {
        "Provider": "InMemory"
      }
    },
    "Redis": {
      "Configuration": "localhost:6379"
    },
    "DomainDefaults": {
      "OutputCacheEnabled": true,
      "FusionCacheEnabled": true,
      "ClientCacheability": "Public",
      "ClientTtlSeconds": 20,
      "ClientTtlMinSeconds": 10,
      "OutputCacheTtlSeconds": 20,
      "FusionCacheSoftTtlSeconds": 60,
      "FusionCacheHardTtlSeconds": 120,
      "FusionCacheFailSafeSeconds": 600,
      "FusionCacheVaryOnPublicAddress": false,
      "OutputCacheVaryByHost": false
    },
    "Domains": {
      "catalog": {
        "Version": "v2",
        "OutputCacheTtlSeconds": 12,
        "FusionCacheSoftTtlSeconds": 45,
        "FusionCacheHardTtlSeconds": 90,
        "ClientCacheability": "Public",
        "ClientTtlSeconds": 15,
        "ClientTtlMinSeconds": 8
      },
      "product-detail": {
        "Version": "v1",
        "OutputCacheTtlSeconds": 30,
        "FusionCacheSoftTtlSeconds": 90,
        "FusionCacheHardTtlSeconds": 180,
        "ClientCacheability": "Public",
        "ClientTtlSeconds": 30,
        "ClientTtlMinSeconds": 15
      },
      "search": {
        "Version": "v1",
        "OutputCacheTtlSeconds": 8,
        "FusionCacheSoftTtlSeconds": 20,
        "FusionCacheHardTtlSeconds": 40,
        "ClientCacheability": "Public",
        "ClientTtlSeconds": 5,
        "ClientTtlMinSeconds": 5
      },
      "product-crud": {
        "Version": "1",
        "ETagMode": "Resource",
        "OutputCacheTtlSeconds": 45,
        "FusionCacheSoftTtlSeconds": 90,
        "FusionCacheHardTtlSeconds": 180,
        "ClientCacheability": "Public",
        "ClientTtlSeconds": 20,
        "ClientTtlMinSeconds": 10
      },
      "vary-demo": {
        "Version": "v1",
        "VaryByAccept": true,
        "AcceptNormalizationList": [ "application/json", "application/xml" ],
        "VaryByQueryKeys": [ "lang" ],
        "AuthBypassMode": "Never",
        "VaryOutputCacheByUser": false,
        "OutputCacheTtlSeconds": 30,
        "FusionCacheSoftTtlSeconds": 60,
        "FusionCacheHardTtlSeconds": 120,
        "ClientCacheability": "Public",
        "ClientTtlSeconds": 20,
        "ClientTtlMinSeconds": 10
      }
    }
  },
  "Demo": {
    "Endpoints": [
      {
        "Path": "/api/catalog",
        "Domain": "catalog",
        "DelayMs": 80,
        "Label": "Catalog"
      },
      {
        "Path": "/api/products/{id}",
        "Domain": "product-detail",
        "DelayMs": 60,
        "Label": "Product detail (id=42)"
      },
      {
        "Path": "/api/search",
        "Domain": "search",
        "DelayMs": 40,
        "Label": "Search"
      }
    ]
  }
}