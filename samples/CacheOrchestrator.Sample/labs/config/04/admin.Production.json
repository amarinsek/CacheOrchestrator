{
  "AdminConsole": {
    "ApiKey": "dev-admin-key",
    "RequestTimeoutMs": 5000,
    "Parallelism": 8,
    "AdminApiPathPrefix": "/cache-admin/local",
    "Instances": [
      { "id": "playground-a", "url": "http://playground-a:8080" },
      { "id": "playground-b", "url": "http://playground-b:8080" }
    ],
    "Metrics": {
      "Enabled": true,
      "Provider": "Prometheus",
      "BaseUrl": "http://prometheus:9090"
    },
    "Hints": {
      "RuleFiles": [ "data/rules/*.json" ],
      "DisabledStatePath": "data/disabled.local.json"
    }
  }
}
