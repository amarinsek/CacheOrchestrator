{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "CacheOrchestrator": "Information"
    }
  },
  "AllowedHosts": "*",
  "Cache": {
    "Namespace": "sample",
    "InstanceId": "local-playground",
    "Metrics": {
      "IncludeEndpointLabel": true
    },
    "Admin": {
      "Enabled": true,
      "ApiKey": "dev-admin-key",
      "TrackLatency": true,
      "TrackResultSize": true
    },
    "OutputCache": {
      "Provider": "InMemory"
    },
    "DataCacheInstances": {
      "default": {
        "Provider": "InMemory"
      }
    },
    "Redis": {
      "Configuration": "localhost:6379"
    },
    "DomainDefaults": {
      "DataCache": {
        "Enabled": true,
        "Ttl": "00:01:00",
        "HardTtl": "00:02:00",
        "FailSafe": "00:10:00",
        "VaryOnPublicAddress": false
      },
      "OutputCache": {
        "Enabled": true,
        "Ttl": "00:00:20",
        "VaryByHost": false
      },
      "ClientCache": {
        "Cacheability": "Public",
        "Ttl": "00:00:20",
        "TtlMin": "00:00:10"
      },
    },
    "Domains": {
      "catalog": {
        "Version": "v2",
        "DataCache": {
          "Ttl": "00:00:45",
          "HardTtl": "00:01:30"
        },
        "OutputCache": {
          "Ttl": "00:00:12"
        },
        "ClientCache": {
          "Cacheability": "Public",
          "Ttl": "00:00:15",
          "TtlMin": "00:00:08"
        },
      },
      "product-detail": {
        "Version": "v1",
        "DataCache": {
          "Ttl": "00:01:30",
          "HardTtl": "00:03:00"
        },
        "OutputCache": {
          "Ttl": "00:00:30"
        },
        "ClientCache": {
          "Cacheability": "Public",
          "Ttl": "00:00:30",
          "TtlMin": "00:00:15"
        },
      },
      "search": {
        "Version": "v1",
        "DataCache": {
          "Ttl": "00:00:20",
          "HardTtl": "00:00:40"
        },
        "OutputCache": {
          "Ttl": "00:00:08"
        },
        "ClientCache": {
          "Cacheability": "Public",
          "Ttl": "00:00:05",
          "TtlMin": "00:00:05"
        },
      },
      "product-crud": {
        "Version": "1",
        "DataCache": {
          "Ttl": "00:01:30",
          "HardTtl": "00:03:00"
        },
        "OutputCache": {
          "Ttl": "00:00:45",
          "ETagMode": "Resource"
        },
        "ClientCache": {
          "Cacheability": "Public",
          "Ttl": "00:00:20",
          "TtlMin": "00:00:10"
        },
      },
      "vary-demo": {
        "Version": "v1",
        "VaryByAccept": true,
        "AcceptNormalizationList": [ "application/json", "application/xml" ],
        "VaryByQueryKeys": [ "lang" ],
        "AuthBypassMode": "Never",
        "VaryOutputCacheByUser": false,
        "DataCache": {
          "Ttl": "00:01:00",
          "HardTtl": "00:02:00"
        },
        "OutputCache": {
          "Ttl": "00:00:30"
        },
        "ClientCache": {
          "Cacheability": "Public",
          "Ttl": "00:00:20",
          "TtlMin": "00:00:10"
        },
      }
    }
  },
  "Demo": {
    "Endpoints": [
      {
        "Path": "/api/catalog",
        "Domain": "catalog",
        "DelayMs": 80,
        "Label": "Catalog"
      },
      {
        "Path": "/api/products/{id}",
        "Domain": "product-detail",
        "DelayMs": 60,
        "Label": "Product detail (id=42)"
      },
      {
        "Path": "/api/search",
        "Domain": "search",
        "DelayMs": 40,
        "Label": "Search"
      }
    ]
  }
}
