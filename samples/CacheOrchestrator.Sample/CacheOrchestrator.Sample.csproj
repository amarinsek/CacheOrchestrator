<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<RootNamespace>CacheOrchestrator.Sample</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\CacheOrchestrator\CacheOrchestrator.csproj" />
		<ProjectReference Include="..\..\src\CacheOrchestrator.Redis\CacheOrchestrator.Redis.csproj" />
		<ProjectReference Include="..\..\src\CacheOrchestrator.Bus\CacheOrchestrator.Bus.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- Explicit: Bus depends on this; VS/host runs sometimes miss transitive copy for multi-TF Bus. -->
		<PackageReference Include="Microsoft.Extensions.ServiceDiscovery" Version="10.0.0" />
		<!-- Keep OpenTelemetry stack aligned; 1.15.3+ patches OpenTelemetry.Api GHSA-g94r-2vxg-569j -->
		<PackageReference Include="OpenTelemetry.Api" Version="1.15.3" />
		<PackageReference Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" Version="1.15.3-beta.1" />
		<PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.15.3" />
	</ItemGroup>

</Project>