{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Cache": {
    "Namespace": "minimal",
    "OutputCache": { "Provider": "InMemory" },
    "FusionCacheInstances": {
      "default": { "Provider": "InMemory" }
    },
    "Domains": {
      "hello": {
        "Version": "1",
        "ClientCacheability": "Public",
        "ClientTtlSeconds": 30,
        "ClientTtlMinSeconds": 5,
        "OutputCacheTtlSeconds": 60,
        "FusionCacheSoftTtlSeconds": 120
      }
    }
  }
}
