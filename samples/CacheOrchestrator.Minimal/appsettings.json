{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Cache": {
    "Namespace": "minimal",
    "InstanceId": "local-minimal",
    "OutputCache": { "Provider": "InMemory" },
    "DataCacheInstances": {
      "default": { "Provider": "InMemory" }
    },
    "Domains": {
      "hello": {
        "Version": "1",
        "DataCache": {
          "TtlSeconds": 120
        },
        "OutputCache": {
          "TtlSeconds": 60
        },
        "ClientCache": {
          "Cacheability": "Public",
          "TtlSeconds": 30,
          "TtlMinSeconds": 5
        }
      }
    },
    "Admin": {
      "Enabled": true,
      "ApiKey": "dev-admin-key"
    }
  }
}
