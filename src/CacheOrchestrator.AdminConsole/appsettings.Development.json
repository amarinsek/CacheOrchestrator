{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information"
    }
  },
  "AdminConsole": {
    "ApiKey": "dev-admin-key",
    "Instances": [
      {
        "id": "local-playground",
        "url": "http://localhost:5289"
      }
    ],
    "Metrics": {
      "Enabled": true,
      "Provider": "Prometheus",
      "BaseUrl": "http://localhost:9090"
    },
    "Hints": {
      "RuleFiles": [ "hints/*.json" ],
      "DisabledCodes": [],
      "DisabledStatePath": "hints/disabled.local.json"
    }
  }
}
