<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Operator host: multi-target so it can run where only net8 or net10 is available.
         Instance apps may use either TFM independently (Admin talks HTTP only). -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>CacheOrchestrator.Admin.App</RootNamespace>
    <AssemblyName>CacheOrchestrator.Admin</AssemblyName>
    <Description>CacheOrchestrator Admin App — multi-instance fan-out UI over the Admin API on each application instance.</Description>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Built-in Microsoft.AspNetCore.OpenApi document generation exists on net9+ only.
       net8 uses Swashbuckle for the OpenAPI document so Scalar still works in Development. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.9.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.0" />
    <PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />
  </ItemGroup>

  <ItemGroup>
    <!-- Scalar supports net8+; same package for both TFMs -->
    <PackageReference Include="Scalar.AspNetCore" Version="2.4.18" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CacheOrchestrator\CacheOrchestrator.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ship rule packs + operator handbook with publish/output -->
    <Content Update="hints\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Update="README.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
