<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>net8.0;net10.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<PackageId>CacheOrchestrator</PackageId>
		<!-- Canonical short description — keep in sync with root README / NuGet / GitHub About -->
		<Description>Domain-based configuration and coordination for ASP.NET Core Output Cache, FusionCache, and client Cache-Control — not a cache of its own. Redis backends: install CacheOrchestrator.Redis.</Description>
		<PackageTags>cache;caching;domain;outputcache;fusioncache;httpcache;aspnetcore;performance</PackageTags>
		<!-- NuGet.org shows this file (not the root GitHub README — HTML/logo-friendly for GitHub only). -->
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageIcon>logo-small.png</PackageIcon>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);1591</NoWarn>
		<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
	</PropertyGroup>

	<ItemGroup>
		<!-- Package readme: short markdown that renders cleanly on nuget.org -->
		<None Include="README.md" Pack="true" PackagePath="\" />
		<None Include="..\..\docs\assets\logo-small.png" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<!-- Core packages only (no Redis). Redis backends: CacheOrchestrator.Redis. -->
	<ItemGroup>
		<PackageReference Include="ZiggyCreatures.FusionCache" Version="2.6.0" />
		<PackageReference Include="ZiggyCreatures.FusionCache.Serialization.SystemTextJson" Version="2.6.0" />
		<PackageReference Include="System.IO.Hashing" Version="10.0.10" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="CacheOrchestrator.UnitTests" />
		<InternalsVisibleTo Include="CacheOrchestrator.Redis.UnitTests" />
		<InternalsVisibleTo Include="CacheOrchestrator.Bus.UnitTests" />
		<InternalsVisibleTo Include="CacheOrchestrator.EFCore.Invalidation.UnitTests" />
		<InternalsVisibleTo Include="CacheOrchestrator.Benchmarks" />
		<InternalsVisibleTo Include="CacheOrchestrator.Bus" />
	</ItemGroup>
</Project>
